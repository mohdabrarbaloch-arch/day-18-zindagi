# Zindagi — environment configuration
# Copy this file to .env and fill in real values.

# --- App ---
APP_NAME=Zindagi Blood Donor Network
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- Database ---
# SQLite (dev):  sqlite:///./zindagi.db
# PostgreSQL (prod, docker-compose):  postgresql+psycopg://zindagi:zindagi@db:5432/zindagi
DATABASE_URL=sqlite:///./zindagi.db

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting (requests per minute) ---
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=60

# --- Donor eligibility rules ---
MIN_AGE=18
MAX_AGE=60
MIN_WEIGHT_KG=50
DONATION_COOLDOWN_DAYS=90

# --- Request expiry windows (hours) ---
EXPIRY_NORMAL_HOURS=72
EXPIRY_URGENT_HOURS=24
EXPIRY_EMERGENCY_HOURS=6
